{
  "name": "@enmaq/mdgl",
  "version": "0.3.0",
  "description": "MDGL 0.1 parser, checker, evaluator, terminal-cell renderer and terminal player.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "UNICODE-LICENSE.txt"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "test:types": "tsc -p test/consumer",
    "test": "npm run build && npm run test:types && node --test test/*.test.js",
    "example:js": "npm run build && node examples/render.mjs",
    "example:ts": "npm run build && tsc -p examples && node .examples/render.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enmaq/mdgl.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/enmaq/mdgl#readme",
  "bugs": "https://github.com/enmaq/mdgl/issues",
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "mdgl",
    "markdown",
    "animation",
    "terminal"
  ],
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "bin": {
    "mdgl": "bin/mdgl.js",
    "mdgl-adapter": "bin/mdgl-adapter.js"
  }
}
