scene width=48 height=14 period=5s repeat=infinite fallback=@2.5
actor card = rect(20, 6, border=round, title="parent") at (left+2, top+2) color=accent
actor dot = circle(1) at (4, 3) parent=card color=red
actor note = text("child moves with it") at (2, 1) parent=card
@0: card.move(to=(right-2, bottom-1), dur=2.5, ease=ease-in-out)
@0: dot.color(to=green, dur=2.5)
@2.5: card.scale(to=1.3, dur=1, ease=ease-out)
@3.5: card.scale(to=1, dur=1, ease=bounce)
