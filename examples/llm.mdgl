mdgl 0.1
scene width=96 height=30 period=43s repeat=infinite fallback=end
# LLM inference loop: a typical decoder-only transformer, simplified. Numbers are illustrative.
actor title = text("How a language model writes: one token at a time") at (2, 0) color=yellow
actor sub = text("a decoder-only causal inference loop, simplified; ids and numbers are illustrative") at (2, 1)
actor l1 = text("1  the prompt is plain text") at (2, 3) color=white
actor l2 = text("2  tokenization: subword pieces, each with an illustrative id") at (2, 3) color=white
actor l3 = text("3  embedding + position: each token becomes a vector") at (2, 3) color=white
actor l4 = text("4  N x transformer block: attention, then feed-forward") at (2, 3) color=white
actor l5 = text("5  logits -> softmax: a probability for every vocabulary token") at (2, 3) color=white
actor l6 = text("6  pick one token - greedy (top score) or sampled (weighted draw)") at (2, 3) color=white
actor l7 = text("7  append it to the context and run the loop again") at (2, 3) color=white
actor prompt = text("The cat sat on the") at (8, 6)
actor b0 = rect(11, 3, border=square, title="The") at (8, 5) color=yellow
actor i0 = text("#464") at (11, 6) color=yellow
actor b1 = rect(11, 3, border=square, title=" cat") at (21, 5) color=yellow
actor i1 = text("#3797") at (24, 6) color=yellow
actor b2 = rect(11, 3, border=square, title=" sat") at (34, 5) color=yellow
actor i2 = text("#3332") at (37, 6) color=yellow
actor b3 = rect(11, 3, border=square, title=" on") at (47, 5) color=yellow
actor i3 = text("#319") at (50, 6) color=yellow
actor b4 = rect(11, 3, border=square, title=" the") at (60, 5) color=yellow
actor i4 = text("#262") at (63, 6) color=yellow
actor g3 = text(" ") at (0, 0)
actor emb = text("[.3 -.8 .1]  [.7 .2 -.5]  [-.4 .9 .6]  [.1 -.3 .8]  [.5 .5 -.2]") at (8, 10) color=green parent=g3
actor pos = text("+ pos 0      + pos 1      + pos 2      + pos 3      + pos 4") at (8, 11) color=magenta parent=g3
actor sum = text("=[.4 -.6 .5] =[.9 .6 -.3] =[-.4 .9 .4] =[.4 -.3 .9] =[.3 .8 -.1]") at (8, 12) color=green parent=g3
actor dn = text("     ▼            ▼            ▼            ▼            ▼") at (8, 13) parent=g3
actor g4 = text(" ") at (0, 0)
actor blk = rect(66, 8, border=round, title=" N x transformer block ") at (6, 14) color=white parent=g4
actor nodes = text("( p0 )       ( p1 )       ( p2 )       ( p3 )       ( p4 )") at (10, 15) color=cyan parent=g4
actor br = text("┌────────────┬────────────┬────────────┬────────────┐") at (13, 16) color=cyan parent=g4
actor att = text("causal self-attention: p4 sees itself + earlier tokens only") at (9, 17) color=cyan parent=g4
actor ffn = text("then feed-forward network, applied to each position") at (9, 18) parent=g4
actor lay = text("really: many layers and heads (not drawn)") at (9, 19) parent=g4
actor last = text("only the LAST position's output is used ▼") at (26, 22) color=red parent=g4
actor mt = text("causal mask") at (74, 14) color=cyan parent=g4
actor m0 = text("■ · · · ·") at (76, 15) color=cyan parent=g4
actor m1 = text("■ ■ · · ·") at (76, 16) color=cyan parent=g4
actor m2 = text("■ ■ ■ · ·") at (76, 17) color=cyan parent=g4
actor m3 = text("■ ■ ■ ■ ·") at (76, 18) color=cyan parent=g4
actor m4 = text("■ ■ ■ ■ ■") at (76, 19) color=cyan parent=g4
actor g5 = text(" ") at (0, 0)
actor c1 = text("logits = one score per vocabulary token (often 50k+ entries)") at (8, 10) color=blue parent=g5
actor c2 = text("softmax -> probabilities that sum to 1   [top 4 shown, ILLUSTRATIVE]") at (8, 11) color=blue parent=g5
actor p0 = text("\" mat\"   ████████████████████ 41%") at (8, 13) color=blue parent=g5
actor p1 = text("\" floor\" ████████████ 23%") at (8, 15) color=blue parent=g5
actor p2 = text("\" sofa\"  ███████ 14%") at (8, 17) color=blue parent=g5
actor p3 = text("\" rug\"   ████ 9%") at (8, 19) color=blue parent=g5
actor oth = text("all other tokens  13% (illustrative)") at (8, 21) parent=g5
actor cb = rect(11, 3, border=square, title=" mat") at (52, 13) color=red
actor ci = text("#2603") at (3, 1) color=red parent=cb
actor loop = text("↺  loop: 6 tokens in -> next token out -> append -> run again") at (8, 23) color=yellow
actor o1 = text("generated > The cat sat on the") at (2, 26)
actor o2 = text(" mat") at (32, 26) color=red
actor o3 = text(" and purred.") at (36, 26) color=red
actor note = text("every new token is one more pass through the same loop") at (2, 28)
actor lg0 = text("■ token") at (2, 29) color=yellow
actor lg1 = text("■ embedding") at (12, 29) color=green
actor lg2 = text("■ position") at (26, 29) color=magenta
actor lg3 = text("■ attention") at (39, 29) color=cyan
actor lg4 = text("■ probability") at (53, 29) color=blue
actor lg5 = text("■ chosen") at (70, 29) color=red
@0: title.type(per_char=0.04)
@1.8: sub.fade(in, dur=0.8)
@2.6: lg0.fade(in, dur=0.4)
@2.6: l1.fade(in, dur=0.4)
@2.75: lg1.fade(in, dur=0.4)
@2.9: lg2.fade(in, dur=0.4)
@3: prompt.type(per_char=0.12)
@3.05: lg3.fade(in, dur=0.4)
@3.2: lg4.fade(in, dur=0.4)
@3.35: lg5.fade(in, dur=0.4)
@6.0: l1.fade(out, dur=0.4)
@6.0: prompt.fade(out, dur=0.4)
@6.4: l2.fade(in, dur=0.4)
@6.6: b0.fade(in, dur=0.5)
@7.1: b1.fade(in, dur=0.5)
@7.6: b2.fade(in, dur=0.5)
@8.1: b3.fade(in, dur=0.5)
@8.6: b4.fade(in, dur=0.5)
@9.4: i0.fade(in, dur=0.4)
@9.700000000000001: i1.fade(in, dur=0.4)
@10.0: i2.fade(in, dur=0.4)
@10.3: i3.fade(in, dur=0.4)
@10.6: i4.fade(in, dur=0.4)
@11.2: l2.fade(out, dur=0.4)
@11.6: l3.fade(in, dur=0.4)
@12: emb.wipe(in, dur=1.5)
@13.8: pos.wipe(in, dur=1.5)
@15.2: dn.fade(in, dur=0.6)
@15.6: sum.wipe(in, dur=1.5)
@17.6: l3.fade(out, dur=0.4)
@18.0: l4.fade(in, dur=0.4)
@18.0: blk.fade(in, dur=0.8)
@18.9: nodes.wipe(in, dur=0.8)
@19.9: br.wipe(in, dur=1.0)
@20.9: att.wipe(in, dur=1.2)
@20.9: mt.fade(in, dur=0.6)
@21.5: m0.wipe(in, dur=0.3)
@21.75: m1.wipe(in, dur=0.3)
@22.0: m2.wipe(in, dur=0.3)
@22.25: m3.wipe(in, dur=0.3)
@22.5: m4.wipe(in, dur=0.3)
@22.6: ffn.wipe(in, dur=1.0)
@23.6: lay.fade(in, dur=0.6)
@23.9: last.wipe(in, dur=0.6)
@24.5: last.blink(times=2, dur=0.8)
@25.2: l4.fade(out, dur=0.4)
@25.4: g3.fade(out, dur=0.6)
@25.4: g4.fade(out, dur=0.6)
@26.0: l5.fade(in, dur=0.4)
@26.4: c1.fade(in, dur=0.5)
@26.9: c2.fade(in, dur=0.5)
@27.6: p0.wipe(in, dur=0.6)
@28.1: p1.wipe(in, dur=0.6)
@28.6: p2.wipe(in, dur=0.6)
@29.1: p3.wipe(in, dur=0.6)
@29.8: oth.fade(in, dur=0.5)
@31.0: l5.fade(out, dur=0.4)
@31.4: l6.fade(in, dur=0.4)
@31.6: p0.color(to=red, dur=0.4)
@32.0: p0.blink(times=3, dur=1.0)
@33.0: cb.fade(in, dur=0.4)
@33.0: g5.fade(out, dur=0.6)
@33.5: cb.move(to=(73, 13), dur=0.7, ease=ease-in-out)
@34.2: cb.move(to=(73, 5), dur=0.7, ease=ease-in-out)
@34.6: l6.fade(out, dur=0.4)
@35.0: l7.fade(in, dur=0.4)
@35.0: o1.wipe(in, dur=1.0)
@36.0: o2.type(per_char=0.25)
@37.0: loop.wipe(in, dur=1.0)
@38.0: loop.blink(times=2, dur=1.0)
@38.0: note.fade(in, dur=0.6)
@39.0: o3.type(per_char=0.3)
