mdgl 0.1
scene width=96 height=34 period=18s fallback=end
actor frame = rect(96, 34, border=round, title="KUBERNETES  /  FROM DESIRED STATE TO SERVICE") at (0, 0) color=cyan
actor phase1 = text("01  DECLARE + PERSIST") at (3, 2) color=yellow
actor phase2 = text("02  RECONCILE + PLACE") at (3, 11) color=cyan
actor phase3 = text("03  START + SERVE") at (3, 21) color=green
actor operator = rect(20, 5, border=round, title="OPERATOR") at (2, 4) color=yellow
actor api = rect(22, 5, border=round, title="API SERVER") at (35, 4) color=cyan
actor etcd = rect(16, 5, border=round, title="etcd") at (78, 4) color=magenta
actor want = text("Deployment x3") at (5, 6) color=yellow
actor api1 = text("REST / validate") at (37, 6) color=cyan
actor api2 = text("persist object") at (37, 7) color=white
actor stored = text("API data") at (80, 6) color=magenta
actor requestWire = text("----------->") at (22, 6) color=cyan
actor storeWire = text("---------------->") at (58, 6) color=magenta
actor request = text(">") at (22, 6) color=yellow
actor write = text(">") at (58, 6) color=magenta
actor controllers = rect(25, 5, border=round, title="CONTROLLERS") at (3, 13) color=cyan
actor scheduler = rect(20, 5, border=round, title="SCHEDULER") at (36, 13) color=yellow
actor node = rect(27, 5, border=round, title="WORKER NODE") at (66, 13) color=green
actor reconcile = text("ReplicaSet creates Pods") at (5, 15) color=cyan
actor place = text("binds Pod to node") at (38, 15) color=yellow
actor kubelet = text("kubelet asks CRI") at (68, 15) color=green
actor podWire = text("------->") at (28, 15) color=cyan
actor bindWire = text("-------->") at (57, 15) color=yellow
actor podToken = text(">") at (28, 15) color=cyan
actor bindToken = text(">") at (57, 15) color=yellow
actor client = rect(18, 4, border=round, title="CLIENT") at (3, 23) color=white
actor service = rect(22, 4, border=round, title="SERVICE") at (36, 23) color=blue
actor pod = rect(22, 4, border=round, title="READY POD 1/3") at (71, 23) color=green
actor http = text("HTTP request") at (5, 25) color=white
actor vip = text("stable address") at (38, 25) color=blue
actor endpoint = text("ready endpoint") at (73, 25) color=green
actor clientWire = text("------------>") at (22, 25) color=blue
actor serviceWire = text("------------>") at (58, 25) color=blue
actor inbound = text(">") at (22, 25) color=white
actor traffic = text(">") at (58, 25) color=blue
actor boot = text(">") at (78, 18) color=green
actor foot1 = text("One of 3 replicas. EndpointSlice tracks matching Pods; proxy routes ready endpoints.") at (4, 29) color=white
actor foot2 = text("Controllers keep comparing desired and observed state, then correct drift.") at (4, 31) color=cyan
@0: frame.fade(in, dur=0.6, ease=ease-out)
@0: phase1.fade(in, dur=0.5)
@0: operator.fade(in, dur=0.7)
@0.3: want.type(per_char=0.07)
@1: request.fade(in, dur=0.2)
@1: request.move(to=(33, 6), dur=1, ease=linear)
@2.1: api.fade(in, dur=0.6)
@2.2: api1.fade(in, dur=0.5)
@2.8: api2.fade(in, dur=0.5)
@3.2: write.fade(in, dur=0.2)
@3.2: write.move(to=(76, 6), dur=1.2, ease=linear)
@4.5: etcd.fade(in, dur=0.6)
@4.6: stored.fade(in, dur=0.5)
@5: phase2.fade(in, dur=0.5)
@5.2: controllers.fade(in, dur=0.6)
@5.3: reconcile.fade(in, dur=0.5)
@6.1: podToken.fade(in, dur=0.2)
@6.1: podToken.move(to=(35, 15), dur=0.8, ease=linear)
@6.8: scheduler.fade(in, dur=0.6)
@6.9: place.fade(in, dur=0.5)
@7.7: bindToken.fade(in, dur=0.2)
@7.7: bindToken.move(to=(64, 15), dur=0.7, ease=linear)
@8.4: node.fade(in, dur=0.6)
@8.5: kubelet.fade(in, dur=0.5)
@9: boot.fade(in, dur=0.2)
@9: boot.move(to=(78, 22), dur=0.8, ease=ease-out)
@9.8: phase3.fade(in, dur=0.5)
@10: pod.fade(in, dur=0.7)
@10.1: endpoint.fade(in, dur=0.5)
@11: client.fade(in, dur=0.6)
@11.1: http.fade(in, dur=0.5)
@11.8: service.fade(in, dur=0.6)
@11.9: vip.fade(in, dur=0.5)
@12: inbound.fade(in, dur=0.2)
@12: inbound.move(to=(34, 25), dur=1, ease=linear)
@13.2: traffic.fade(in, dur=0.2)
@13.2: traffic.move(to=(70, 25), dur=1.2, ease=linear)
@14.6: foot1.type(per_char=0.025)
@15: foot2.type(per_char=0.025)
